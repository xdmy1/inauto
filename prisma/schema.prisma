// Prisma schema for inauto.md — Neon Postgres (Vercel storage integration).
// Local dev uses the same database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Car {
  id           String   @id @default(cuid())
  slug         String   @unique
  brand        String
  model        String
  year         Int
  price        Int // EUR
  oldPrice     Int? // EUR, for discount display
  downPayment  Int? // "prima rată", EUR
  monthlyRate  Int? // EUR / month, optional
  body         String // sedan, suv, hatchback...
  fuel         String // petrol, diesel, hybrid, phev, electric, gas
  transmission String // automatic, manual
  drivetrain   String? // fwd, rwd, awd
  mileage      Int // km
  engineCc     Int?
  powerHp      Int?
  color        String?
  seats        Int?
  vin          String?
  location     String? // parking address
  descriptionRo String @default("")
  descriptionRu String @default("")
  // equipment / options, one per line ("Climatronic", "Scaune încălzite"...)
  equipmentRo  String   @default("")
  equipmentRu  String   @default("")
  status       String   @default("DRAFT") // DRAFT | PUBLISHED | RESERVED | SOLD | ARCHIVED
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  images CarImage[]
  advert Advert999?

  @@index([status, createdAt])
  @@index([brand, model])
}

model CarImage {
  id       String @id @default(cuid())
  carId    String
  car      Car    @relation(fields: [carId], references: [id], onDelete: Cascade)
  // relative path under the uploads dir, e.g. "cars/<carId>/<file>.webp"
  path     String
  width    Int?
  height   Int?
  order    Int    @default(0)

  @@index([carId, order])
}

// Link between a local car and its 999.md advert.
// source = where the listing was born: "site" (admin → pushed to 999.md) or
// "nnn" (posted on 999.md → imported here). The origin side is the master.
model Advert999 {
  id           String    @id @default(cuid())
  carId        String    @unique
  car          Car       @relation(fields: [carId], references: [id], onDelete: Cascade)
  advertId     String?   @unique // id returned by partners-api.999.md — one car per advert, ever
  source       String    @default("site") // site | nnn
  state        String    @default("PENDING") // PENDING | SYNCED | DRY_RUN | ERROR | DISABLED
  nnnState     String? // public | hidden | expired | blocked | need_pay ... (as reported by 999.md)
  nnnUpdatedAt DateTime? // "republished"/"posted" timestamp of the advert on 999.md
  lastError    String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

}

// One row per sync run (import from 999.md / export), for the admin panel
model SyncRun {
  id         String    @id @default(cuid())
  kind       String // import | export
  trigger    String    @default("manual") // manual | cron | auto
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  summary    String? // "3 noi · 2 actualizate · 1 arhivată"
  details    String? // warnings, one per line
  error      String?

  @@index([kind, startedAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  createdAt    DateTime @default(now())
}
