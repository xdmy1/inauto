[Unit]
Description=inauto.md (Next.js)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=inauto
WorkingDirectory=/opt/inauto/app
Environment=NODE_ENV=production
# "localhost", not 127.0.0.1: Next compares the middleware URL host with
# "localhost"; any other host turns next-intl rewrites into proxy calls (500)
# and its redirects into loops
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H localhost -p 3100
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
